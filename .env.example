NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Reto Lily <noreply@yourdomain.com>
ADMIN_EMAIL=your@email.com

NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Código Cero
# Valores admitidos: audio | video
NEXT_PUBLIC_CODIGO_CERO_MEDIA_TYPE=audio

# Ejemplos:
# /media/codigo-cero.mp3
# /media/codigo-cero.mp4
NEXT_PUBLIC_CODIGO_CERO_MEDIA_SRC=

# Solo se utiliza cuando MEDIA_TYPE=video
# Ejemplo: /images/codigo-cero-poster.webp
NEXT_PUBLIC_CODIGO_CERO_MEDIA_POSTER=
